<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:OriApps.MeetTape"
        x:Class="OriApps.MeetTape.MainWindow" x:DataType="local:MainViewModel"
        Title="MeetTape" Width="1050" Height="820" MinWidth="700" MinHeight="560"
        RequestedThemeVariant="Light" Background="#F8FAFD" FontFamily="Segoe UI">
  <Window.Styles>
    <Style Selector="Border.capture">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#DAE2ED" />
    </Style>
    <Style Selector="Border.capture.recording">
      <Setter Property="Background" Value="#FFF9FA" />
      <Setter Property="BorderBrush" Value="#FFD6DE" />
    </Style>
    <Style Selector="Button.record">
      <Setter Property="Background" Value="#1674E8" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.record.recording">
      <Setter Property="Background" Value="#F42842" />
    </Style>
    <Style Selector="Button.record:pointerover">
      <Setter Property="Background" Value="#0964D7" />
    </Style>
    <Style Selector="Button.record.recording:pointerover">
      <Setter Property="Background" Value="#DE203A" />
    </Style>
    <Style Selector="TextBlock.capture-status.recording">
      <Setter Property="Foreground" Value="#F42842" />
    </Style>
    <Style Selector="Expander.warning">
      <Setter Property="Background" Value="#FFF0E7" />
      <Setter Property="BorderBrush" Value="#FFE0CB" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </Window.Styles>
  <Grid Margin="24" RowDefinitions="Auto,*,Auto" RowSpacing="18">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Margin="8,4,8,0">
      <Image Source="avares://MeetTape/Assets/MeetTape.png" Width="42" Height="42" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="MeetTape" FontSize="28" FontWeight="Bold" Foreground="#101827" />
        <TextBlock Text="{Binding CurrentVersion, StringFormat='v{0}'}" Foreground="#7C8AA3" VerticalAlignment="Center" />
      </StackPanel>
      <Button Grid.Column="2" Name="SettingsButton" Content="Settings" IsEnabled="{Binding CanConfigure}"
              Click="SettingsClick" Padding="22,10" CornerRadius="8" Background="#F5F7FB" BorderBrush="#D4DDEA" BorderThickness="1" />
    </Grid>
    <ScrollViewer Name="MainContent" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="22" Margin="0,0,4,0">
        <Border Name="RecordingCard" Classes="capture" Classes.recording="{Binding IsRecording}"
                Padding="20" CornerRadius="12" BorderThickness="1">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
              <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Fill="#F42842" Width="12" Height="12" IsVisible="{Binding IsRecording}" />
                  <TextBlock Name="CaptureStatus" Classes="capture-status" Classes.recording="{Binding IsRecording}"
                             Text="{Binding CaptureHeading}" FontSize="19" FontWeight="SemiBold" />
                </StackPanel>
                <Grid Name="AudioLevels" ColumnDefinitions="200,*,*" ColumnSpacing="18" IsVisible="{Binding IsRecording}">
                  <TextBlock Name="RecordingTimer" Text="{Binding RecordingDuration}" FontSize="46" FontWeight="Bold" />
                  <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Me: microphone" TextTrimming="CharacterEllipsis" ToolTip.Tip="Me: microphone" />
                    <ProgressBar Name="MeLevel" Value="{Binding MeLevel}" Height="8" MinWidth="0" Foreground="#32BF56" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Them: system playback" TextTrimming="CharacterEllipsis" ToolTip.Tip="Them: system playback" />
                    <ProgressBar Name="ThemLevel" Value="{Binding ThemLevel}" Height="8" MinWidth="0" Foreground="#1674E8" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="Record microphone and system playback" IsVisible="{Binding !IsRecording}" Foreground="#69778E" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                <Button Name="RecordButton" Classes="record" Classes.recording="{Binding IsRecording}"
                        Content="{Binding RecordLabel}" IsEnabled="{Binding CanRecord}" IsVisible="{Binding !IsNaming}"
                        Click="RecordClick" Width="190" Height="56" HorizontalContentAlignment="Center" />
                <TextBlock Name="RecordingShortcut" Text="{Binding RecordingShortcutText}" Foreground="#7C8AA3"
                           FontSize="11" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding PreparationText}" IsVisible="{Binding IsPreparing}" TextWrapping="Wrap" />
            <Expander Name="DiagnosticsExpander" Classes.warning="{Binding HasWarnings}" HorizontalAlignment="Stretch">
              <Expander.Header>
                <StackPanel Spacing="4">
                  <TextBlock Name="Warnings" Text="{Binding WarningSummary}" IsVisible="{Binding HasWarnings}"
                             TextWrapping="Wrap" Foreground="#A65009" />
                  <TextBlock Name="ErrorMessage" Text="{Binding ErrorSummary}" IsVisible="{Binding HasError}"
                             TextWrapping="Wrap" Foreground="#B91C38" />
                  <TextBlock Text="Details" FontSize="12" Foreground="#53637D" />
                </StackPanel>
              </Expander.Header>
              <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBox Name="DiagnosticDetails" Text="{Binding DiagnosticText, Mode=OneWay}" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140" />
                <Button Name="CopyDiagnostics" Content="Copy details" Click="CopyDiagnosticsClick" HorizontalAlignment="Left" />
              </StackPanel>
            </Expander>
            <Border IsVisible="{Binding IsNaming}" Padding="14" Background="#F3F6FB" CornerRadius="8">
              <StackPanel Spacing="10">
                <TextBlock Text="Recording saved. Name the meeting, then continue or start the next recording." TextWrapping="Wrap" />
                <TextBox Name="MeetingTitle" Text="{Binding MeetingTitle}" PlaceholderText="Unnamed meeting" MaxLength="200" />
                <WrapPanel>
                  <Button Name="ContinuePreparation" Content="Continue" IsEnabled="{Binding CanName}" Click="ContinueClick" Margin="0,0,8,8" />
                  <Button Name="StartNextRecording" Content="Start next recording" IsEnabled="{Binding CanStartNextRecording}" Click="StartNextClick" Margin="0,0,8,8" />
                  <Button Name="CancelNamedRecording" Content="Cancel processing" IsEnabled="{Binding CanCancelNamedRecording}" Click="CancelNamedClick" Margin="0,0,8,8" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border IsVisible="{Binding ShowTrim}" Padding="14" Background="#F3F6FB" CornerRadius="8">
              <StackPanel Spacing="10">
                <TextBlock Name="TrimSuggestion" Text="{Binding TrimText}" TextWrapping="Wrap" />
                <WrapPanel IsEnabled="{Binding CanTrim}">
                  <Button Name="AcceptTrim" Content="Accept" Click="AcceptClick" Margin="0,0,8,8" />
                  <Button Name="SkipTrim" Content="Skip" Click="SkipClick" Margin="0,0,8,8" />
                  <TextBox Name="TrimStart" Text="{Binding TrimStart}" Width="90" PlaceholderText="Start" Margin="0,0,8,8" />
                  <TextBox Name="TrimEnd" Text="{Binding TrimEnd}" Width="90" PlaceholderText="End" Margin="0,0,8,8" />
                  <Button Name="ManualTrim" Content="Apply interval" Click="ManualClick" Margin="0,0,8,8" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <TextBlock Text="Meetings" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Name="MeetingSearch" Text="{Binding SearchText}" Width="300"
                     PlaceholderText="Search meetings by title or date..." CornerRadius="8" />
          </Grid>
          <Border BorderBrush="#DAE2ED" BorderThickness="1" CornerRadius="9" Background="White" ClipToBounds="True">
            <Grid RowDefinitions="Auto,Auto">
              <Grid ColumnDefinitions="3*,2*,1.3*,2*,40" ColumnSpacing="8" Background="#F0F4F9" Margin="0" Height="42">
                <TextBlock Text="Title" Margin="16,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Date" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="Duration" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="Status" VerticalAlignment="Center" />
              </Grid>
              <ListBox Grid.Row="1" Name="SessionList" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                       Background="Transparent" BorderThickness="0" MinHeight="150" MaxHeight="400"
                       ContextRequested="SessionContextRequested" DoubleTapped="SessionDoubleTapped">
                <ListBox.ContextMenu>
                  <ContextMenu Name="SessionMenu">
                    <MenuItem Name="OpenSessionFolder" Header="Open folder" IsEnabled="{Binding CanOpen}" Click="FolderClick" />
                    <MenuItem Name="OpenTranscript" Header="Transcript" IsEnabled="{Binding CanOpenTranscript}" Click="TranscriptClick" />
                    <MenuItem Name="OpenSummaryFile" Header="Summary file" IsEnabled="{Binding CanOpenSummary}" Click="SummaryFileClick" />
                    <MenuItem Name="CopyMenu" Header="Copy" IsEnabled="{Binding CanCopyDocument}">
                      <MenuItem Name="CopyTranscript" Header="Copy transcript" IsEnabled="{Binding CanOpenTranscript}" Click="CopyTranscriptClick" />
                      <MenuItem Name="CopySummary" Header="Copy summary" IsEnabled="{Binding CanOpenSummary}" Click="CopySummaryClick" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Name="PrepareSession" Header="Name / Trim" IsEnabled="{Binding CanPrepare}" Click="PrepareClick" />
                    <MenuItem Name="ResumeSession" Header="Resume processing" IsEnabled="{Binding CanResume}" Click="ResumeClick" />
                    <MenuItem Name="RequestSummary" Header="{Binding SummaryLabel}" IsEnabled="{Binding CanSummary}" Click="SummaryClick" />
                    <MenuItem Name="CancelSessionProcessing" Header="Cancel processing" IsVisible="{Binding HasCancelableSelection}" IsEnabled="{Binding CanCancelProcessing}" Click="CancelProcessingClick" />
                    <MenuItem Name="DeleteRecording" Header="Delete recording" IsEnabled="{Binding CanDeleteRecording}" Click="DeleteRecordingClick" />
                    <Separator />
                    <MenuItem Name="MeetingDetails" Header="Details" IsEnabled="{Binding CanOpen}" Click="MeetingDetailsClick" />
                  </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:SessionRow">
                    <Border BorderThickness="0,0,0,1" BorderBrush="#EDF1F6">
                      <Grid ColumnDefinitions="3*,2*,1.3*,2*,40" ColumnSpacing="8" MinHeight="54">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Title}" Margin="16,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Date}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Duration}" FontSize="13" VerticalAlignment="Center" />
                        <Border Grid.Column="3" Background="{Binding StatusBackground}" CornerRadius="12" Padding="8,4"
                                VerticalAlignment="Center" HorizontalAlignment="Left" ToolTip.Tip="{Binding Progress}">
                          <TextBlock Text="{Binding DisplayStatus}" Foreground="{Binding StatusForeground}" FontSize="12" />
                        </Border>
                        <Button Grid.Column="4" Name="SessionActions" Content="&#x22EE;" Click="SessionActionsClick"
                                Width="30" Height="32" Padding="0" FontSize="20" CornerRadius="6" VerticalAlignment="Center"
                                Background="#F5F7FB" BorderBrush="#D4DDEA" BorderThickness="1" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
          <TextBlock Name="ProcessingIssues" Text="{Binding ProcessingIssueSummary}" IsVisible="{Binding HasProcessingIssues}"
                     TextWrapping="Wrap" Foreground="#B91C38" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <TextBlock Grid.Row="2" Text="{Binding InfoText}" TextWrapping="Wrap" Foreground="#7C8AA3" FontSize="12" />
  </Grid>
</Window>
