<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:MeetTape"
        x:Class="MeetTape.MainWindow" x:DataType="local:MainViewModel"
        Title="MeetTape" Width="860" Height="720" MinWidth="700" MinHeight="560">
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
      <TextBlock Text="MeetTape" FontSize="26" FontWeight="SemiBold" />
      <TextBlock Grid.Row="1" Text="{Binding ReleaseText}" Opacity="0.65" TextWrapping="Wrap" />
      <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" Spacing="8">
        <Button Content="Settings" IsEnabled="{Binding CanConfigure}" Click="SettingsClick" />
        <Button Name="UpdateButton" Content="Update" IsEnabled="{Binding CanUpdate}" Click="UpdateClick" />
        <Button Content="Exit" Click="ExitClick" />
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Name="CaptureStatus" Text="{Binding CaptureText}" FontSize="20" VerticalAlignment="Center" />
          <Button Grid.Column="1" Name="RecordButton" Content="{Binding RecordLabel}" IsEnabled="{Binding CanRecord}" Click="RecordClick" />
        </Grid>
        <TextBlock Text="Me: microphone · Them: system playback" Opacity="0.65" />
        <Grid Name="AudioLevels" ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8" IsVisible="{Binding IsRecording}">
          <TextBlock Text="Me" VerticalAlignment="Center" />
          <ProgressBar Grid.Column="1" Name="MeLevel" Value="{Binding MeLevel}" Height="6" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="Them" VerticalAlignment="Center" />
          <ProgressBar Grid.Column="3" Name="ThemLevel" Value="{Binding ThemLevel}" Height="6" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Name="Warnings" Text="{Binding WarningSummary}" IsVisible="{Binding HasWarnings}" TextWrapping="Wrap" Foreground="DarkOrange" />
        <TextBlock Name="ErrorMessage" Text="{Binding ErrorSummary}" IsVisible="{Binding HasError}" TextWrapping="Wrap" Foreground="IndianRed" />
        <TextBlock Text="{Binding PreparationText}" IsVisible="{Binding IsPreparing}" TextWrapping="Wrap" />
        <ProgressBar Name="UpdateProgress" Value="{Binding UpdateProgress}" IsVisible="{Binding IsUpdating}" Height="6" />
        <Expander Name="DiagnosticsExpander" Header="Details" HorizontalAlignment="Stretch">
          <StackPanel Spacing="8">
            <TextBox Name="DiagnosticDetails" Text="{Binding DiagnosticText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160" />
            <Button Name="CopyDiagnostics" Content="Copy details" Click="CopyDiagnosticsClick" HorizontalAlignment="Left" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="2" Spacing="12">
      <Border IsVisible="{Binding IsNaming}" Padding="12" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" CornerRadius="6">
        <StackPanel Spacing="8">
          <TextBlock Text="Recording saved. Name the meeting (optional), then continue or start the next recording." TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox Name="MeetingTitle" Text="{Binding MeetingTitle}" PlaceholderText="Unnamed meeting" MaxLength="200" />
            <Button Grid.Column="1" Name="ContinuePreparation" Content="Continue" IsEnabled="{Binding CanName}" Click="ContinueClick" />
            <Button Grid.Column="2" Name="StartNextRecording" Content="Start next recording" IsEnabled="{Binding CanStartNextRecording}" Click="StartNextClick" />
          </Grid>
          <Button Name="CancelNamedRecording" Content="Cancel processing" IsEnabled="{Binding CanCancelNamedRecording}" Click="CancelNamedClick" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
      <Border IsVisible="{Binding ShowTrim}" Padding="12" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" CornerRadius="6">
        <StackPanel Spacing="8">
          <TextBlock Name="TrimSuggestion" Text="{Binding TrimText}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding CanTrim}">
            <Button Name="AcceptTrim" Content="Accept" Click="AcceptClick" />
            <Button Name="SkipTrim" Content="Skip" Click="SkipClick" />
            <TextBox Name="TrimStart" Text="{Binding TrimStart}" Width="100" PlaceholderText="Start" />
            <TextBox Name="TrimEnd" Text="{Binding TrimEnd}" Width="100" PlaceholderText="End" />
            <Button Name="ManualTrim" Content="Apply interval" Click="ManualClick" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
    <Grid Grid.Row="3" RowDefinitions="Auto,*,Auto" RowSpacing="8">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
        <TextBlock Text="Meetings" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Name="MeetingSearch" Text="{Binding SearchText}" PlaceholderText="Search title or date" />
      </Grid>
      <ListBox Grid.Row="1" Name="SessionList" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="local:SessionRow">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" Margin="4" RowSpacing="4">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{Binding Status}" Margin="16,0,0,0" />
              <TextBlock Grid.Row="1" Text="{Binding Date}" Opacity="0.65" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Progress}" Opacity="0.65" />
              <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Value="{Binding ProgressPercent}" Height="3" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Row="2" Spacing="8">
        <TextBlock Name="ProcessingIssues" Text="{Binding ProcessingIssueSummary}" IsVisible="{Binding HasProcessingIssues}" TextWrapping="Wrap" Foreground="IndianRed" />
        <TextBlock Text="{Binding SelectedDiagnosticSummary}" TextWrapping="Wrap" Foreground="IndianRed" />
        <WrapPanel>
          <Button Content="Open folder" IsEnabled="{Binding CanOpen}" Click="FolderClick" Margin="0,0,8,8" />
          <Button Content="Transcript" IsEnabled="{Binding CanOpenTranscript}" Click="TranscriptClick" Margin="0,0,8,8" />
          <Button Content="Summary file" IsEnabled="{Binding CanOpenSummary}" Click="SummaryFileClick" Margin="0,0,8,8" />
          <Button Name="CopyMenu" Content="Copy…" IsEnabled="{Binding CanCopyDocument}" Margin="0,0,8,8">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Name="CopyTranscript" Header="Copy transcript" IsEnabled="{Binding CanOpenTranscript}" Click="CopyTranscriptClick" />
                <MenuItem Name="CopySummary" Header="Copy summary" IsEnabled="{Binding CanOpenSummary}" Click="CopySummaryClick" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Name="PrepareSession" Content="Name / Trim" IsEnabled="{Binding CanPrepare}" Click="PrepareClick" Margin="0,0,8,8" />
          <Button Name="ResumeSession" Content="Resume processing" IsEnabled="{Binding CanResume}" Click="ResumeClick" Margin="0,0,8,8" />
          <Button Name="CancelSessionProcessing" Content="Cancel processing" IsVisible="{Binding HasCancelableSelection}" IsEnabled="{Binding CanCancelProcessing}" Click="CancelProcessingClick" Margin="0,0,8,8" />
          <Button Name="RequestSummary" Content="{Binding SummaryLabel}" IsEnabled="{Binding CanSummary}" Click="SummaryClick" Margin="0,0,8,8" />
        </WrapPanel>
      </StackPanel>
    </Grid>
    <TextBlock Grid.Row="4" Text="{Binding InfoText}" TextWrapping="Wrap" Opacity="0.7" />
  </Grid>
</Window>
