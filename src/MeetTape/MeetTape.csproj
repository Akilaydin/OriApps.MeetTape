<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- CI publishes explicit versioned releases; source builds must not report a release version. -->
    <Version>0.0.0</Version>
    <ApplicationIcon>../../assets/MeetTape.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="NAudio.Wasapi" Version="3.2.0" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MeetTape.Tests" />
    <InternalsVisibleTo Include="MeetTape.UiTests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="../../assets/MeetTape.ico" Link="Assets/MeetTape.ico" />
    <AvaloniaResource Include="../../assets/MeetTape.png" Link="Assets/MeetTape.png" />
    <AvaloniaResource Include="../../assets/MeetTape-recording.ico" Link="Assets/MeetTape-recording.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\config.example.json" LogicalName="MeetTape.Defaults.config.json" />
    <EmbeddedResource Include="..\..\prompts\transcription.md" LogicalName="MeetTape.Defaults.transcription.md" />
    <EmbeddedResource Include="..\..\prompts\summary.md" LogicalName="MeetTape.Defaults.summary.md" />
  </ItemGroup>

</Project>
