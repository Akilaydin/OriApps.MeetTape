<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- CI publishes explicit versioned releases; source builds must not report a release version. -->
    <Version>0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\config.example.json" LogicalName="MeetTape.Defaults.config.json" />
    <EmbeddedResource Include="..\..\prompts\transcription.md" LogicalName="MeetTape.Defaults.transcription.md" />
    <EmbeddedResource Include="..\..\prompts\summary.md" LogicalName="MeetTape.Defaults.summary.md" />
    <EmbeddedResource Include="..\..\install.ps1" LogicalName="MeetTape.Installer.install.ps1" />
    <EmbeddedResource Include="..\..\update.ps1" LogicalName="MeetTape.Installer.update.ps1" />
    <EmbeddedResource Include="..\..\tools\InstallerPath.ps1" LogicalName="MeetTape.Installer.InstallerPath.ps1" />
  </ItemGroup>

</Project>
