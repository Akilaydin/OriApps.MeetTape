<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:OriApps.MeetTape.Desktop"
        xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
        x:Class="OriApps.MeetTape.Desktop.MainWindow" x:DataType="local:MainViewModel"
        Title="MeetTape" Width="1100" Height="810" MinWidth="700" MinHeight="560"
        RequestedThemeVariant="Dark" Background="{DynamicResource WindowBackgroundColor}" FontFamily="Segoe UI">
  <Window.Styles>
    <!-- Kept local so Settings and existing dialogs continue to use Avalonia Fluent. -->
    <shad:ShadTheme />
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource ForegroundLeadColor}" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.2" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundLeadColor}" />
    </Style>
    <Style Selector="Border.surface">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Border.subsurface">
      <Setter Property="Background" Value="{DynamicResource GhostColor}" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.capture.recording">
      <Setter Property="BorderBrush" Value="{DynamicResource DestructiveColor}" />
    </Style>
    <Style Selector="TextBlock.capture-status.recording">
      <Setter Property="Foreground" Value="{DynamicResource DestructiveColor}" />
    </Style>
    <Style Selector="Button.record">
      <Setter Property="Height" Value="44" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource GhostColor}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Global toolbar -->
    <Border Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="0,0,0,1" Padding="28,16">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
        <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource GhostColor}" Padding="6">
          <Image Source="avares://MeetTape/Assets/MeetTape.png" Stretch="Uniform" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <StackPanel Orientation="Horizontal" Spacing="9">
            <TextBlock Text="MeetTape" FontSize="21" FontWeight="Bold" VerticalAlignment="Center" />
            <shad:Badge Classes="Outline" Content="{Binding CurrentVersion, StringFormat='v{0}'}"
                        VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Classes="muted" FontSize="11" Text="RECORD  /  TRANSCRIBE  /  REVISIT" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Background="{DynamicResource GhostColor}" CornerRadius="9" Padding="3">
            <StackPanel Orientation="Horizontal" Spacing="3">
              <Button Name="LightThemeButton" Content="Light" Classes="Ghost" Click="LightThemeClick"
                      Width="62" Height="32" Padding="8,4" AutomationProperties.Name="Light theme" />
              <Button Name="DarkThemeButton" Content="Dark" Classes="Primary" Click="DarkThemeClick"
                      Width="62" Height="32" Padding="8,4" AutomationProperties.Name="Dark theme" />
            </StackPanel>
          </Border>
          <Button Grid.Column="2" Name="SettingsButton" Content="⚙  Settings" Classes="Outline"
                  IsEnabled="{Binding CanConfigure}" Click="SettingsClick" Height="38" Padding="16,8" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Name="MainContent" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto" Background="{DynamicResource WindowBackgroundColor}">
      <StackPanel Spacing="24" Margin="28,24,28,28">
        <StackPanel Spacing="6">
          <TextBlock Classes="eyebrow" Text="YOUR WORKSPACE" />
          <TextBlock Text="Meetings, under control." FontSize="29" FontWeight="SemiBold" />
          <TextBlock Classes="muted" FontSize="13" Text="Record both sides of the conversation. Keep every transcript in one place." TextWrapping="Wrap" />
        </StackPanel>

        <!-- Main recorder -->
        <Border Name="RecordingCard" Classes="surface capture" Classes.recording="{Binding IsRecording}" Padding="24">
          <StackPanel Spacing="19">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
              <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                  <Ellipse Width="8" Height="8" Fill="#2EB67D" VerticalAlignment="Center"
                           IsVisible="{Binding !IsRecording}" />
                  <Ellipse Width="8" Height="8" Fill="#F04452" VerticalAlignment="Center"
                           IsVisible="{Binding IsRecording}" />
                  <TextBlock Classes="eyebrow" Text="CAPTURE STATUS" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Name="CaptureStatus" Classes="capture-status" Classes.recording="{Binding IsRecording}"
                           Text="{Binding CaptureHeading}" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Classes="muted" Text="Microphone + system audio, saved as separate tracks"
                           IsVisible="{Binding !IsRecording}" TextWrapping="Wrap" FontSize="13" />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="9">
                <Button Name="RecordButton" Classes="record" Classes.Primary="{Binding !IsRecording}"
                        Classes.Destructive="{Binding IsRecording}"
                        Content="{Binding RecordLabel}" IsEnabled="{Binding CanRecord}" IsVisible="{Binding !IsNaming}"
                        Click="RecordClick" Width="190" />
                <Button Name="MuteMeButton" Classes.Outline="{Binding !IsMeMuted}" Classes.Destructive="{Binding IsMeMuted}"
                        Content="{Binding MuteMeLabel}" IsEnabled="{Binding CanMuteMe}" IsVisible="{Binding IsRecording}"
                        Click="MuteMeClick" Width="190" Height="36" />
                <TextBlock Name="RecordingShortcut" Classes="muted" Text="{Binding RecordingShortcutText}"
                           FontSize="11" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>

            <Grid Name="AudioLevels" ColumnDefinitions="145,*,*" ColumnSpacing="22" IsVisible="{Binding IsRecording}">
              <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Classes="eyebrow" Text="ELAPSED" />
                <TextBlock Name="RecordingTimer" Text="{Binding RecordingDuration}" FontSize="29"
                           FontFamily="Consolas" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="{Binding MeCaptureLabel}" TextTrimming="CharacterEllipsis" FontSize="12" />
                <ProgressBar Name="MeLevel" Value="{Binding MeLevel}" Height="7" MinWidth="0" Foreground="#27AA78" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="{Binding ThemCaptureLabel}" TextTrimming="CharacterEllipsis" FontSize="12" />
                <ProgressBar Name="ThemLevel" Value="{Binding ThemLevel}" Height="7" MinWidth="0" Foreground="#6478DE" />
              </StackPanel>
            </Grid>

            <TextBlock Text="{Binding PreparationText}" IsVisible="{Binding IsPreparing}" TextWrapping="Wrap" />
            <Border Classes="subsurface" IsVisible="{Binding HasCaptureWarning}" Padding="12,10">
              <TextBlock Name="CaptureDeviceWarning" Text="{Binding CaptureWarning}" IsVisible="{Binding HasCaptureWarning}" TextWrapping="Wrap"
                         Foreground="#D99835" FontSize="12" />
            </Border>
            <Border Classes="subsurface" IsVisible="{Binding HasError}" Padding="12,10">
              <TextBlock Name="ErrorMessage" Text="{Binding ErrorText}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
                         Foreground="#E85B65" FontSize="12" />
            </Border>

            <Border Classes="subsurface" IsVisible="{Binding IsNaming}" Padding="18">
              <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="Finish your recording" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" Text="Give it a name, then continue processing or start another recording."
                             FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <TextBox Name="MeetingTitle" Text="{Binding MeetingTitle}" PlaceholderText="Unnamed meeting"
                         MaxLength="200" />
                <WrapPanel>
                  <Button Name="ContinuePreparation" Classes="Primary" Content="Continue" IsEnabled="{Binding CanName}"
                          Click="ContinueClick" Margin="0,0,8,8" />
                  <Button Name="StartNextRecording" Classes="Outline" Content="Start next recording"
                          IsEnabled="{Binding CanStartNextRecording}" Click="StartNextClick" Margin="0,0,8,8" />
                  <Button Name="CancelNamedRecording" Classes="Ghost" Content="Cancel processing"
                          IsEnabled="{Binding CanCancelNamedRecording}" Click="CancelNamedClick" Margin="0,0,8,8" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Classes="subsurface" IsVisible="{Binding ShowTrim}" Padding="18">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Trim recording" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Name="TrimSuggestion" Classes="muted" Text="{Binding TrimText}"
                               FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                  <shad:Badge Grid.Column="1" Classes="Outline" Content="{Binding TrimDurationText}"
                              VerticalAlignment="Center" />
                </Grid>
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="42,*,116" RowSpacing="12" ColumnSpacing="10"
                      IsEnabled="{Binding CanTrim}">
                  <TextBlock Text="Start" VerticalAlignment="Center" FontSize="12" />
                  <Slider Grid.Column="1" Name="TrimStartSlider" Minimum="0"
                          Maximum="{Binding TrimStartSliderMaximum}" Value="{Binding TrimStartPosition, Mode=TwoWay}"
                          TickFrequency="1" VerticalAlignment="Center" AutomationProperties.Name="Trim start slider" />
                  <TextBox Grid.Column="2" Name="TrimStart" Text="{Binding TrimStart, Mode=TwoWay}"
                           PlaceholderText="HH:MM:SS" AutomationProperties.Name="Trim start time" />
                  <TextBlock Grid.Row="1" Text="End" VerticalAlignment="Center" FontSize="12" />
                  <Slider Grid.Row="1" Grid.Column="1" Name="TrimEndSlider" Minimum="{Binding TrimEndSliderMinimum}"
                          Maximum="{Binding TrimDurationSeconds}" Value="{Binding TrimEndPosition, Mode=TwoWay}"
                          TickFrequency="1" VerticalAlignment="Center" AutomationProperties.Name="Trim end slider" />
                  <TextBox Grid.Row="1" Grid.Column="2" Name="TrimEnd" Text="{Binding TrimEnd, Mode=TwoWay}"
                           PlaceholderText="HH:MM:SS" AutomationProperties.Name="Trim end time" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                            IsEnabled="{Binding CanTrim}">
                  <Button Name="SkipTrim" Classes="Outline" Content="Skip" Click="SkipClick" />
                  <Button Name="AcceptTrim" Classes="Primary" Content="Accept trim" Click="AcceptClick" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Meetings collection -->
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Meeting library" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" />
                <shad:Badge Classes="Secondary" Content="{Binding Sessions.Count}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Classes="muted" Text="Select a recording to open its transcript or manage processing."
                         FontSize="12" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
              <TextBox Name="MeetingSearch" Text="{Binding SearchText}" Width="275"
                       PlaceholderText="Search by title or date..." />
              <Button Name="ImportMediaButton" Content="Import audio or video" Click="ImportMediaClick"
                      Classes="Outline" HorizontalAlignment="Right" IsEnabled="{Binding CanImportMedia}" />
            </StackPanel>
          </Grid>
          <Border Classes="surface" ClipToBounds="True">
            <Grid RowDefinitions="Auto,Auto">
              <Grid ColumnDefinitions="3*,1.55*,1*,1.35*,38" ColumnSpacing="10"
                    Background="{DynamicResource GhostColor}" Height="39">
                <TextBlock Classes="eyebrow" Text="MEETING" Margin="16,0,0,0" VerticalAlignment="Center" />
                <TextBlock Classes="eyebrow" Grid.Column="1" Text="DATE" VerticalAlignment="Center" />
                <TextBlock Classes="eyebrow" Grid.Column="2" Text="LENGTH" VerticalAlignment="Center" />
                <TextBlock Classes="eyebrow" Grid.Column="3" Text="STATUS" VerticalAlignment="Center" />
              </Grid>
              <ListBox Grid.Row="1" Name="SessionList" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                       Background="Transparent" BorderThickness="0" Padding="0" MinHeight="140" MaxHeight="400"
                       ContextRequested="SessionContextRequested" DoubleTapped="SessionDoubleTapped">
                <ListBox.ContextMenu>
                  <ContextMenu Name="SessionMenu">
                    <MenuItem Name="OpenSessionFolder" Header="Open folder" IsEnabled="{Binding CanOpen}" Click="FolderClick" />
                    <MenuItem Name="OpenTranscript" Header="Transcript" IsEnabled="{Binding CanOpenTranscript}" Click="TranscriptClick" />
                    <MenuItem Name="OpenSummaryFile" Header="Summary file" IsEnabled="{Binding CanOpenSummary}" Click="SummaryFileClick" />
                    <MenuItem Name="CopyMenu" Header="Copy" IsEnabled="{Binding CanCopyDocument}">
                      <MenuItem Name="CopyTranscript" Header="Copy transcript" IsEnabled="{Binding CanOpenTranscript}" Click="CopyTranscriptClick" />
                      <MenuItem Name="CopySummary" Header="Copy summary" IsEnabled="{Binding CanOpenSummary}" Click="CopySummaryClick" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Name="PrepareSession" Header="Name / Trim" IsEnabled="{Binding CanPrepare}" Click="PrepareClick" />
                    <MenuItem Name="RecoverSession" Header="Recover recording" IsEnabled="{Binding CanRecover}" Click="RecoverClick" />
                    <MenuItem Name="ResumeSession" Header="Resume processing" IsEnabled="{Binding CanResume}" Click="ResumeClick" />
                    <MenuItem Name="RequestSummary" Header="{Binding SummaryLabel}" IsEnabled="{Binding CanSummary}" Click="SummaryClick" />
                    <MenuItem Name="CancelSessionProcessing" Header="Cancel processing" IsVisible="{Binding HasCancelableSelection}" IsEnabled="{Binding CanCancelProcessing}" Click="CancelProcessingClick" />
                    <MenuItem Name="DeleteRecording" Header="Delete recording" IsEnabled="{Binding CanDeleteRecording}" Click="DeleteRecordingClick" />
                    <Separator />
                    <MenuItem Name="MeetingDetails" Header="Details" IsEnabled="{Binding CanOpen}" Click="MeetingDetailsClick" />
                  </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:SessionRow">
                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderColor30}">
                      <Grid ColumnDefinitions="3*,1.55*,1*,1.35*,38" ColumnSpacing="10" MinHeight="62">
                        <StackPanel Margin="16,8,4,8" VerticalAlignment="Center" Spacing="4">
                          <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                          <TextBlock Classes="muted" Text="{Binding TranscriptionProfile}" FontSize="11"
                                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TranscriptionProfile}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Date}" FontSize="12"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Duration}" FontSize="12"
                                   VerticalAlignment="Center" FontFamily="Consolas" />
                        <Border Grid.Column="3" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="7" Padding="8,5" HorizontalAlignment="Left" VerticalAlignment="Center"
                                ToolTip.Tip="{Binding Progress}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="6" Height="6" Fill="{Binding StatusForeground}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DisplayStatus}" FontSize="11" FontWeight="Medium" />
                          </StackPanel>
                        </Border>
                        <Button Grid.Column="4" Name="SessionActions" Classes="Ghost" Content="⋯"
                                Click="SessionActionsClick" Width="32" Height="32" Padding="0" FontSize="19"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                ToolTip.Tip="Meeting actions" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
          <Border Classes="subsurface" IsVisible="{Binding HasProcessingIssues}" Padding="12,10">
            <TextBlock Name="ProcessingIssues" Text="{Binding ProcessingIssueSummary}" IsVisible="{Binding HasProcessingIssues}"
                       TextWrapping="Wrap" Foreground="#E85B65" FontSize="12" />
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="0,1,0,0" Padding="28,11">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <Ellipse Width="7" Height="7" Fill="#36B785" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="muted" Text="{Binding InfoText}"
                   TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
